type Query {
    transactions: [Transaction]
    transactionById(id: ID!): Transaction
    transactionsByAccountId(accountId: ID!): [Transaction]
}

type Mutation {
    createTransaction(request: TransactionInput!): Transaction
    transferMoney(request: TransferInput!): TransferResult
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
}

type TransferResult {
    debitTransactionId: ID!
    creditTransactionId: ID!
    sourceAccountId: ID!
    destinationAccountId: ID!
    amount: Float!
    currency: String!
    status: String!
    timestamp: String!
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    sourceAccountId: ID!
    destinationAccountId: ID!
    amount: Float!
    currency: String!
}
